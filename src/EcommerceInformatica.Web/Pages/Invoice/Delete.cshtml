@page
@model EcommerceInformatica.Web.Pages.Invoice.DeleteModel
@{
    ViewData["Title"] = "Delete Invoice";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-trash"></i> Delete Invoice</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    @if (Model.Invoice != null)
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i>
            <strong>Warning!</strong> Are you sure you want to delete this invoice? This action cannot be undone and may affect related invoice details.
        </div>

        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">Invoice to Delete</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Invoice Number:</dt>
                    <dd class="col-sm-9">@Model.Invoice.InvoiceNumber</dd>

                    <dt class="col-sm-3">Person:</dt>
                    <dd class="col-sm-9">@Model.Invoice.PersonName</dd>

                    <dt class="col-sm-3">Payment Method:</dt>
                    <dd class="col-sm-9">@Model.Invoice.PaymentMethodName</dd>

                    <dt class="col-sm-3">Invoice Date:</dt>
                    <dd class="col-sm-9">@Model.Invoice.InvoiceDate.ToString("MMM dd, yyyy")</dd>

                    <dt class="col-sm-3">Total Amount:</dt>
                    <dd class="col-sm-9">@Model.Invoice.TotalAmount.ToString("C")</dd>

                    <dt class="col-sm-3">Status:</dt>
                    <dd class="col-sm-9">
                        @if (Model.Invoice.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Created Date:</dt>
                    <dd class="col-sm-9">@Model.Invoice.CreatedDate.ToString("MMM dd, yyyy HH:mm")</dd>

                    <dt class="col-sm-3">Created By:</dt>
                    <dd class="col-sm-9">@Model.Invoice.CreatedBy</dd>
                </dl>
            </div>
            <div class="card-footer">
                <form method="post">
                    <input type="hidden" asp-for="Invoice.Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Confirm Delete
                    </button>
                    <a asp-page="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i> Invoice not found.
        </div>
    }
</div>
