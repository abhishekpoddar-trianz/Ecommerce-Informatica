@page
@model EcommerceInformatica.Web.Pages.Invoice.DetailsModel
@{
    ViewData["Title"] = "Invoice Details";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-receipt"></i> Invoice Details</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    @if (Model.Invoice != null)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Invoice: @Model.Invoice.InvoiceNumber</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Invoice Number:</dt>
                    <dd class="col-sm-9">@Model.Invoice.InvoiceNumber</dd>

                    <dt class="col-sm-3">Person:</dt>
                    <dd class="col-sm-9">@Model.Invoice.PersonName</dd>

                    <dt class="col-sm-3">Payment Method:</dt>
                    <dd class="col-sm-9">@Model.Invoice.PaymentMethodName</dd>

                    <dt class="col-sm-3">Invoice Date:</dt>
                    <dd class="col-sm-9">@Model.Invoice.InvoiceDate.ToString("MMM dd, yyyy")</dd>

                    <dt class="col-sm-3">Total Amount:</dt>
                    <dd class="col-sm-9">@Model.Invoice.TotalAmount.ToString("C")</dd>

                    <dt class="col-sm-3">Status:</dt>
                    <dd class="col-sm-9">
                        @if (Model.Invoice.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Created Date:</dt>
                    <dd class="col-sm-9">@Model.Invoice.CreatedDate.ToString("MMM dd, yyyy HH:mm")</dd>

                    <dt class="col-sm-3">Created By:</dt>
                    <dd class="col-sm-9">@Model.Invoice.CreatedBy</dd>

                    @if (Model.Invoice.ModifiedDate.HasValue)
                    {
                        <dt class="col-sm-3">Modified Date:</dt>
                        <dd class="col-sm-9">@Model.Invoice.ModifiedDate.Value.ToString("MMM dd, yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Modified By:</dt>
                        <dd class="col-sm-9">@Model.Invoice.ModifiedBy</dd>
                    }
                </dl>
            </div>
            <div class="card-footer">
                <div class="btn-group" role="group">
                    <a asp-page="Edit" asp-route-id="@Model.Invoice.Id" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-page="Delete" asp-route-id="@Model.Invoice.Id" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i> Invoice not found.
        </div>
    }
</div>
