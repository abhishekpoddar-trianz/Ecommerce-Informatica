@page
@model EcommerceInformatica.Web.Pages.Product.DetailsModel
@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-box-seam"></i> Product Details</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    @if (Model.Product != null)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">@Model.Product.Name</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Article ID:</dt>
                            <dd class="col-sm-8">@Model.Product.ArticleId</dd>

                            <dt class="col-sm-4">Name:</dt>
                            <dd class="col-sm-8">@Model.Product.Name</dd>

                            <dt class="col-sm-4">Supplier:</dt>
                            <dd class="col-sm-8">@Model.Product.SupplierName</dd>

                            <dt class="col-sm-4">Brand:</dt>
                            <dd class="col-sm-8">@Model.Product.BrandName</dd>

                            <dt class="col-sm-4">Category:</dt>
                            <dd class="col-sm-8">@Model.Product.CategoryName</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Stock:</dt>
                            <dd class="col-sm-8">
                                <span class="badge @(Model.Product.Stock > 10 ? "bg-success" : Model.Product.Stock > 0 ? "bg-warning" : "bg-danger")">
                                    @Model.Product.Stock units
                                </span>
                            </dd>

                            <dt class="col-sm-4">Unit Price:</dt>
                            <dd class="col-sm-8">@Model.Product.UnitPrice.ToString("C")</dd>

                            <dt class="col-sm-4">Status:</dt>
                            <dd class="col-sm-8">
                                @if (Model.Product.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </dd>

                            <dt class="col-sm-4">Created Date:</dt>
                            <dd class="col-sm-8">@Model.Product.CreatedDate.ToString("MMM dd, yyyy HH:mm")</dd>

                            <dt class="col-sm-4">Created By:</dt>
                            <dd class="col-sm-8">@Model.Product.CreatedBy</dd>
                        </dl>
                    </div>
                </div>

                @if (Model.Product.ModifiedDate.HasValue)
                {
                    <hr />
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Modified Date:</dt>
                                <dd class="col-sm-8">@Model.Product.ModifiedDate.Value.ToString("MMM dd, yyyy HH:mm")</dd>

                                <dt class="col-sm-4">Modified By:</dt>
                                <dd class="col-sm-8">@Model.Product.ModifiedBy</dd>
                            </dl>
                        </div>
                    </div>
                }
            </div>
            <div class="card-footer">
                <div class="btn-group" role="group">
                    <a asp-page="Edit" asp-route-id="@Model.Product.Id" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-page="Delete" asp-route-id="@Model.Product.Id" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i> Product not found.
        </div>
    }
</div>
