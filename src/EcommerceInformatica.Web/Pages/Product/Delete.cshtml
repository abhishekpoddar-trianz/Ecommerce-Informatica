@page
@model EcommerceInformatica.Web.Pages.Product.DeleteModel
@{
    ViewData["Title"] = "Delete Product";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-trash"></i> Delete Product</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    @if (Model.Product != null)
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i>
            <strong>Warning!</strong> Are you sure you want to delete this product? This action cannot be undone.
        </div>

        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">Product to Delete</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Article ID:</dt>
                            <dd class="col-sm-8">@Model.Product.ArticleId</dd>

                            <dt class="col-sm-4">Name:</dt>
                            <dd class="col-sm-8">@Model.Product.Name</dd>

                            <dt class="col-sm-4">Supplier:</dt>
                            <dd class="col-sm-8">@Model.Product.SupplierName</dd>

                            <dt class="col-sm-4">Brand:</dt>
                            <dd class="col-sm-8">@Model.Product.BrandName</dd>

                            <dt class="col-sm-4">Category:</dt>
                            <dd class="col-sm-8">@Model.Product.CategoryName</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Stock:</dt>
                            <dd class="col-sm-8">@Model.Product.Stock units</dd>

                            <dt class="col-sm-4">Unit Price:</dt>
                            <dd class="col-sm-8">@Model.Product.UnitPrice.ToString("C")</dd>

                            <dt class="col-sm-4">Status:</dt>
                            <dd class="col-sm-8">
                                @if (Model.Product.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </dd>

                            <dt class="col-sm-4">Created Date:</dt>
                            <dd class="col-sm-8">@Model.Product.CreatedDate.ToString("MMM dd, yyyy HH:mm")</dd>

                            <dt class="col-sm-4">Created By:</dt>
                            <dd class="col-sm-8">@Model.Product.CreatedBy</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <form method="post">
                    <input type="hidden" asp-for="Product.Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Confirm Delete
                    </button>
                    <a asp-page="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i> Product not found.
        </div>
    }
</div>
