@page
@model EcommerceInformatica.Web.Pages.Supplier.DetailsModel
@{
    ViewData["Title"] = "Supplier Details";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-truck"></i> Supplier Details</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    @if (Model.Supplier != null)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">@Model.Supplier.Name</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Name:</dt>
                    <dd class="col-sm-9">@Model.Supplier.Name</dd>

                    <dt class="col-sm-3">Contact Person:</dt>
                    <dd class="col-sm-9">@Model.Supplier.ContactPerson</dd>

                    <dt class="col-sm-3">Email:</dt>
                    <dd class="col-sm-9">@Model.Supplier.Email</dd>

                    <dt class="col-sm-3">Phone:</dt>
                    <dd class="col-sm-9">@Model.Supplier.Phone</dd>

                    <dt class="col-sm-3">Address:</dt>
                    <dd class="col-sm-9">@Model.Supplier.Address</dd>

                    <dt class="col-sm-3">Status:</dt>
                    <dd class="col-sm-9">
                        @if (Model.Supplier.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Created Date:</dt>
                    <dd class="col-sm-9">@Model.Supplier.CreatedDate.ToString("MMM dd, yyyy HH:mm")</dd>

                    <dt class="col-sm-3">Created By:</dt>
                    <dd class="col-sm-9">@Model.Supplier.CreatedBy</dd>

                    @if (Model.Supplier.ModifiedDate.HasValue)
                    {
                        <dt class="col-sm-3">Modified Date:</dt>
                        <dd class="col-sm-9">@Model.Supplier.ModifiedDate.Value.ToString("MMM dd, yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Modified By:</dt>
                        <dd class="col-sm-9">@Model.Supplier.ModifiedBy</dd>
                    }
                </dl>
            </div>
            <div class="card-footer">
                <div class="btn-group" role="group">
                    <a asp-page="Edit" asp-route-id="@Model.Supplier.Id" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-page="Delete" asp-route-id="@Model.Supplier.Id" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i> Supplier not found.
        </div>
    }
</div>
