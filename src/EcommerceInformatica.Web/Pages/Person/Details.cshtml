@page
@model EcommerceInformatica.Web.Pages.Person.DetailsModel
@{
    ViewData["Title"] = "Person Details";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-people"></i> Person Details</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    @if (Model.Person != null)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">@Model.Person.FirstName @Model.Person.LastName</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">First Name:</dt>
                    <dd class="col-sm-9">@Model.Person.FirstName</dd>

                    <dt class="col-sm-3">Last Name:</dt>
                    <dd class="col-sm-9">@Model.Person.LastName</dd>

                    <dt class="col-sm-3">Email:</dt>
                    <dd class="col-sm-9">@Model.Person.Email</dd>

                    <dt class="col-sm-3">Phone:</dt>
                    <dd class="col-sm-9">@Model.Person.Phone</dd>

                    <dt class="col-sm-3">Address:</dt>
                    <dd class="col-sm-9">@Model.Person.Address</dd>

                    <dt class="col-sm-3">City:</dt>
                    <dd class="col-sm-9">@Model.Person.CityName</dd>

                    <dt class="col-sm-3">Province:</dt>
                    <dd class="col-sm-9">@Model.Person.ProvinceName</dd>

                    <dt class="col-sm-3">Username:</dt>
                    <dd class="col-sm-9">@Model.Person.Username</dd>

                    <dt class="col-sm-3">Status:</dt>
                    <dd class="col-sm-9">
                        @if (Model.Person.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Created Date:</dt>
                    <dd class="col-sm-9">@Model.Person.CreatedDate.ToString("MMM dd, yyyy HH:mm")</dd>

                    <dt class="col-sm-3">Created By:</dt>
                    <dd class="col-sm-9">@Model.Person.CreatedBy</dd>

                    @if (Model.Person.ModifiedDate.HasValue)
                    {
                        <dt class="col-sm-3">Modified Date:</dt>
                        <dd class="col-sm-9">@Model.Person.ModifiedDate.Value.ToString("MMM dd, yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Modified By:</dt>
                        <dd class="col-sm-9">@Model.Person.ModifiedBy</dd>
                    }
                </dl>
            </div>
            <div class="card-footer">
                <div class="btn-group" role="group">
                    <a asp-page="Edit" asp-route-id="@Model.Person.Id" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-page="Delete" asp-route-id="@Model.Person.Id" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i> Person not found.
        </div>
    }
</div>
