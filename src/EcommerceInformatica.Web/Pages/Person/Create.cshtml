@page
@model EcommerceInformatica.Web.Pages.Person.CreateModel
@{
    ViewData["Title"] = "Create Person";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-plus-circle"></i> Create Person</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Person Information</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Person.FirstName" class="form-label"></label>
                        <input asp-for="Person.FirstName" class="form-control" />
                        <span asp-validation-for="Person.FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Person.LastName" class="form-label"></label>
                        <input asp-for="Person.LastName" class="form-control" />
                        <span asp-validation-for="Person.LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Person.Email" class="form-label"></label>
                        <input asp-for="Person.Email" class="form-control" type="email" />
                        <span asp-validation-for="Person.Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Person.Phone" class="form-label"></label>
                        <input asp-for="Person.Phone" class="form-control" type="tel" />
                        <span asp-validation-for="Person.Phone" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Person.Address" class="form-label"></label>
                    <textarea asp-for="Person.Address" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Person.Address" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Person.CityId" class="form-label"></label>
                    <select asp-for="Person.CityId" class="form-select" asp-items="Model.Cities">
                        <option value="">-- Select City --</option>
                    </select>
                    <span asp-validation-for="Person.CityId" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Person.Username" class="form-label"></label>
                        <input asp-for="Person.Username" class="form-control" />
                        <span asp-validation-for="Person.Username" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Person.Password" class="form-label"></label>
                        <input asp-for="Person.Password" class="form-control" type="password" />
                        <span asp-validation-for="Person.Password" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="Person.IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="Person.IsActive" class="form-check-label"></label>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Create Person
                    </button>
                    <a asp-page="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
