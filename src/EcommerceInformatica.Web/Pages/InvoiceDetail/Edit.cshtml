@page
@model EcommerceInformatica.Web.Pages.InvoiceDetail.EditModel
@{
    ViewData["Title"] = "Edit Invoice Detail";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-pencil"></i> Edit Invoice Detail</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-warning">
            <h5 class="mb-0">Edit Invoice Detail Information</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="InvoiceDetail.Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="InvoiceDetail.InvoiceId" class="form-label"></label>
                        <select asp-for="InvoiceDetail.InvoiceId" class="form-select" asp-items="Model.Invoices">
                            <option value="">-- Select Invoice --</option>
                        </select>
                        <span asp-validation-for="InvoiceDetail.InvoiceId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="InvoiceDetail.ProductId" class="form-label"></label>
                        <select asp-for="InvoiceDetail.ProductId" class="form-select" asp-items="Model.Products">
                            <option value="">-- Select Product --</option>
                        </select>
                        <span asp-validation-for="InvoiceDetail.ProductId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="InvoiceDetail.Quantity" class="form-label"></label>
                        <input asp-for="InvoiceDetail.Quantity" class="form-control" type="number" min="1" />
                        <span asp-validation-for="InvoiceDetail.Quantity" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="InvoiceDetail.UnitPrice" class="form-label"></label>
                        <input asp-for="InvoiceDetail.UnitPrice" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="InvoiceDetail.UnitPrice" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Current Subtotal</label>
                        <input type="text" class="form-control" readonly value="@Model.InvoiceDetail.Subtotal.ToString("C")" />
                        <small class="text-muted">Will be recalculated on save</small>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="InvoiceDetail.IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="InvoiceDetail.IsActive" class="form-check-label"></label>
                    </div>
                </div>

                <hr />

                <div class="row">
                    <div class="col-md-6">
                        <p class="text-muted small">
                            <strong>Created:</strong> @Model.InvoiceDetail.CreatedDate.ToString("MMM dd, yyyy HH:mm") by @Model.InvoiceDetail.CreatedBy
                        </p>
                    </div>
                    @if (Model.InvoiceDetail.ModifiedDate.HasValue)
                    {
                        <div class="col-md-6">
                            <p class="text-muted small">
                                <strong>Last Modified:</strong> @Model.InvoiceDetail.ModifiedDate.Value.ToString("MMM dd, yyyy HH:mm") by @Model.InvoiceDetail.ModifiedBy
                            </p>
                        </div>
                    }
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                    <a asp-page="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
