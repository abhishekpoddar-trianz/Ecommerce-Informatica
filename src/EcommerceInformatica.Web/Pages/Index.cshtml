@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">
    <h1 class="display-4">Welcome to Ecommerce Informatica</h1>
    <p class="lead">Modern E-commerce Management System</p>
</div>

<div class="row mt-5">
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-box-seam display-1 text-primary"></i>
                <h5 class="card-title mt-3">Products</h5>
                <p class="card-text">Manage your product catalog, brands, categories, and suppliers.</p>
                <a asp-page="/Product/Index" class="btn btn-primary">View Products</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-receipt display-1 text-success"></i>
                <h5 class="card-title mt-3">Sales</h5>
                <p class="card-text">Track invoices, invoice details, and payment methods.</p>
                <a asp-page="/Invoice/Index" class="btn btn-success">View Invoices</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-people display-1 text-info"></i>
                <h5 class="card-title mt-3">Administration</h5>
                <p class="card-text">Manage persons, provinces, cities, and system settings.</p>
                <a asp-page="/Person/Index" class="btn btn-info text-white">Manage Users</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-graph-up"></i> Quick Stats</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6 mb-3">
                        <div class="stat-item">
                            <h3 class="text-primary">@Model.TotalProducts</h3>
                            <p class="text-muted mb-0">Total Products</p>
                        </div>
                    </div>
                    <div class="col-6 mb-3">
                        <div class="stat-item">
                            <h3 class="text-success">@Model.TotalInvoices</h3>
                            <p class="text-muted mb-0">Total Invoices</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-item">
                            <h3 class="text-info">@Model.TotalPersons</h3>
                            <p class="text-muted mb-0">Total Persons</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-item">
                            <h3 class="text-warning">@Model.TotalSuppliers</h3>
                            <p class="text-muted mb-0">Total Suppliers</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> System Information</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li class="mb-2">
                        <i class="bi bi-check-circle text-success"></i>
                        <strong>Status:</strong> System Operational
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-shield-check text-primary"></i>
                        <strong>Security:</strong> Active
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-database text-info"></i>
                        <strong>Database:</strong> Connected
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-clock text-warning"></i>
                        <strong>Last Updated:</strong> @DateTime.Now.ToString("MMM dd, yyyy HH:mm")
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
