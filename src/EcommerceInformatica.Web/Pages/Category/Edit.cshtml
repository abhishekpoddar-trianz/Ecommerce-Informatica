@page
@model EcommerceInformatica.Web.Pages.Category.EditModel
@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-pencil"></i> Edit Category</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-page="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-warning">
            <h5 class="mb-0">Edit Category Information</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="Category.Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Category.Name" class="form-label"></label>
                    <input asp-for="Category.Name" class="form-control" />
                    <span asp-validation-for="Category.Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category.Description" class="form-label"></label>
                    <textarea asp-for="Category.Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Category.Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="Category.IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="Category.IsActive" class="form-check-label"></label>
                    </div>
                </div>

                <hr />

                <div class="row">
                    <div class="col-md-6">
                        <p class="text-muted small">
                            <strong>Created:</strong> @Model.Category.CreatedDate.ToString("MMM dd, yyyy HH:mm") by @Model.Category.CreatedBy
                        </p>
                    </div>
                    @if (Model.Category.ModifiedDate.HasValue)
                    {
                        <div class="col-md-6">
                            <p class="text-muted small">
                                <strong>Last Modified:</strong> @Model.Category.ModifiedDate.Value.ToString("MMM dd, yyyy HH:mm") by @Model.Category.ModifiedBy
                            </p>
                        </div>
                    }
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                    <a asp-page="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
